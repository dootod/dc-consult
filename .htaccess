# Configuration de base
Options -Indexes
DirectoryIndex index.html

# Protection des fichiers sensibles
<Files ".env">
    Require all denied
</Files>
<Files "*.env">
    Require all denied
</Files>
<FilesMatch "\.(htaccess|htpasswd|ini|log|sh|inc|bak)$">
    Require all denied
</FilesMatch>

# En-têtes de sécurité
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options nosniff
    Header always set X-Frame-Options DENY
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://maps.googleapis.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: https: https://maps.gstatic.com https://maps.googleapis.com; connect-src 'self' https://maps.googleapis.com; frame-src https://www.google.com https://maps.googleapis.com;"
</IfModule>

# Protection anti-DOS
<IfModule mod_evasive24.c>
    DOSHashTableSize    3097
    DOSPageCount        5
    DOSPageInterval     1
    DOSSiteCount        50
    DOSSiteInterval     1
    DOSBlockingPeriod   600
</IfModule>

# Pages d'erreur personnalisées
ErrorDocument 401 https://www.dc-consult-bet.fr/error/401.html
ErrorDocument 402 https://www.dc-consult-bet.fr/error/402.html
ErrorDocument 403 https://www.dc-consult-bet.fr/error/403.html
ErrorDocument 404 https://www.dc-consult-bet.fr/error/404.html

# Activation du module de réécriture
RewriteEngine On

# Redirection HTTPS (si nécessaire)
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Redirection www (forcer www)
RewriteCond %{HTTP_HOST} ^dc-consult-bet\.fr [NC]
RewriteRule ^(.*)$ https://www.dc-consult-bet.fr/$1 [L,R=301]

# Règles de réécriture pour des URLs propres
# Page d'accueil
RewriteRule ^accueil/?$ /index.html [L]
RewriteRule ^home/?$ /index.html [L]

# Pages principales avec URLs propres
RewriteRule ^references/?$ /html/references.html [L]
RewriteRule ^nos-references/?$ /html/references.html [L]

RewriteRule ^clients/?$ /html/clients.html [L]
RewriteRule ^nos-clients/?$ /html/clients.html [L]

RewriteRule ^contact/?$ /html/contact.html [L]
RewriteRule ^nous-contacter/?$ /html/contact.html [L]
RewriteRule ^contactez-nous/?$ /html/contact.html [L]

RewriteRule ^logiciels/?$ /html/logicels.html [L]
RewriteRule ^nos-logiciels/?$ /html/logicels.html [L]
RewriteRule ^outils/?$ /html/logicels.html [L]

RewriteRule ^mentions/?$ /html/mentions.html [L]
RewriteRule ^mentions-legales/?$ /html/mentions.html [L]
RewriteRule ^legal/?$ /html/mentions.html [L]

# Règles pour supprimer l'extension .html des URLs (optionnel)
# Redirection des URLs avec .html vers les URLs propres
RewriteCond %{THE_REQUEST} /html/([^.\s]+)\.html [NC]
RewriteRule ^ /%1? [R=301,L]

# Règles internes pour servir les fichiers HTML
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([^/]+)/?$ /html/$1.html [L]

# Gestion des trailing slashes
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} /$
RewriteRule ^(.*)/$  /$1 [R=301,L]

# Compression GZIP (si le module est disponible)
<IfModule mod_deflate.c>
    # Compression des types de fichiers texte
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
</IfModule>

# Cache des fichiers statiques
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType font/woff "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 month"
</IfModule>